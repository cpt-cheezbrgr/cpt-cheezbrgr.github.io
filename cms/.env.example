# Server
PORT=8080
NODE_ENV=production

# Blog
BLOG_TITLE=My Blog
BLOG_DESCRIPTION=A personal blog

# JWT
JWT_SECRET=change-this-to-a-long-random-string-at-least-64-chars

# Google Cloud
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-blog-media-bucket

# Firestore (leave empty when running on GCP — uses ADC automatically)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Email (for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com

# Scheduler (Cloud Scheduler calls this endpoint with the key)
SCHEDULER_SECRET=change-this-to-another-random-string

# Initial admin (used once at first startup to seed the admin user)
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_EMAIL=admin@example.com
INIT_ADMIN_PASSWORD=change-me-immediately
