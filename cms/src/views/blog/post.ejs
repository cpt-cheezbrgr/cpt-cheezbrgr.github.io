<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= post.title %> – <%= blogTitle %></title>
  <% if (post.excerpt) { %><meta name="description" content="<%= post.excerpt %>"><% } %>
  <% if (post.coverImage) { %><meta property="og:image" content="<%= post.coverImage %>"><% } %>
  <link rel="stylesheet" href="/css/blog.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>
  <header class="blog-header">
    <div class="container">
      <a href="/" class="blog-logo"><%= blogTitle %></a>
    </div>
  </header>

  <main class="container post-container">
    <article class="post-full">
      <header class="post-header">
        <% if (post.tags && post.tags.length) { %>
          <div class="tag-list">
            <% post.tags.forEach(tag => { %>
              <a href="/?tag=<%= encodeURIComponent(tag) %>" class="tag">#<%= tag %></a>
            <% }) %>
          </div>
        <% } %>
        <h1 class="post-title"><%= post.title %></h1>
        <div class="post-meta">
          <time datetime="<%= post.publishedAt?.toDate?.()?.toISOString() || '' %>">
            <%= post.publishedAt?.toDate
              ? post.publishedAt.toDate().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
              : '' %>
          </time>
        </div>
        <% if (post.coverImage) { %>
          <img src="<%= post.coverImage %>" alt="<%= post.title %>" class="post-cover-image">
        <% } %>
      </header>

      <div class="post-content">
        <%- post.htmlContent %>
      </div>

      <footer class="post-footer">
        <a href="/" class="back-link">← All posts</a>
      </footer>
    </article>
  </main>

  <footer class="blog-footer">
    <div class="container">
      <p>&copy; <%= new Date().getFullYear() %> <%= blogTitle %></p>
    </div>
  </footer>
</body>
</html>
